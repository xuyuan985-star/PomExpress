# =========================================================
# 帕姆巡宝 PomExpress 环境配置模板
# 使用：复制本文件为 .env 后填写（.env 不入库，勿提交真实 key）
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# =========================================================

# GUI 默认加载的地图（可选）
# DEFAULT_MAP=02_herta_space_station

# 模板匹配置信度阈值（0-1，可选）
# TEMPLATE_THRESHOLD=0.60

# 动作间隔下限（秒，可选；防止连点过快）
# MIN_ACTION_INTERVAL=0.0

# B站 cookie（可选，下载攻略视频用；也可存入 Windows 凭据管理器）
# BILIBILI_COOKIE=SESSDATA=xxx
# BILI_STORE_CREDENTIAL=true

# ============ 游戏启动与游戏内热键（可选） ============
# 原先读自 m7 的 config.yaml；m7 已从项目移除，改为读本项目配置。
# 不填则对应功能降级（不会报错）：GAME_PATH 不填 = 不自动拉起游戏。
#
# GAME_PATH             游戏可执行文件路径（自动拉起游戏时用）
# GAME_PATH=D:\Star Rail\Game\StarRail.exe
#
# 游戏内热键（留空则用括号内的内置默认）
# HOTKEY_MAP=m            地图（默认 m）
# HOTKEY_TECHNIQUE=e      战斗技巧（默认 e）
# HOTKEY_AUTO_BATTLE=v    自动战斗（默认 v）
# HOTKEY_B=               备用键（无默认）
